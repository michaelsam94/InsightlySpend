# Copy to keystore.properties (never commit keystore.properties).
# Generate a keystore once, then keep the file and passwords in a password manager.
#
# Example keytool (PKCS12, 10k-day validity):
#   mkdir -p release
#   keytool -genkeypair -v -storetype PKCS12 \
#     -keystore release/insightly-release.jks \
#     -alias insightly \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=release/insightly-release.jks
storePassword=CHANGE_ME
keyAlias=insightly
keyPassword=CHANGE_ME
